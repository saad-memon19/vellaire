# --- Database (MongoDB Atlas) ---
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.xxxxx.mongodb.net/vellaire

# --- Server ---
PORT=4000
WEB_URL=http://localhost:3000
# At least 32 random characters. Production refuses to start without it.
JWT_SECRET=change-me-to-a-long-random-string
# Emails that get access to the product owner console
PLATFORM_ADMIN_EMAILS=owner@vellaire.app

# --- Email (optional) ---
# Without these, nothing is emailed and everything still works: people sign in with a password, and
# admins share password links by hand. Emails are printed in the API console instead.
# Fill ONE of the two: Resend (an API key) or any email provider's SMTP server.
RESEND_API_KEY=
SMTP_HOST=
# 587 (STARTTLS) or 465 (SSL)
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# The sender. With your own domain, verify it at the provider first.
MAIL_FROM=Vellaire <hello@vellaire.app>

# --- AI (optional): none | claude | openai ---
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=
# Optional: your AI price in USD per million tokens (input / output), for the console cost estimate
AI_COST_IN_PER_MTOK=
AI_COST_OUT_PER_MTOK=

# --- Sign in with Google / Microsoft (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# --- Production on Vercel ---
# File uploads (logos, photos). Create a Blob store in Vercel and connect it to the API project.
BLOB_READ_WRITE_TOKEN=
# Any long random string. Vercel Cron sends it to /cron/<task>; also needed by an external scheduler.
CRON_SECRET=

# --- Wallet passes (optional) ---
APPLE_PASS_TYPE_ID=
APPLE_TEAM_ID=
APPLE_SIGNER_KEY_PASSPHRASE=
# Certificates: base64 text (Vercel) ...
APPLE_WWDR_CERT=
APPLE_SIGNER_CERT=
APPLE_SIGNER_KEY=
# ... or file paths (a normal server): APPLE_WWDR_CERT_PATH, APPLE_SIGNER_CERT_PATH, APPLE_SIGNER_KEY_PATH
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_EMAIL=
GOOGLE_WALLET_PRIVATE_KEY=
