# --- Database (MongoDB Atlas) ---
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.xxxxx.mongodb.net/vellaire

# --- Server ---
PORT=4000
WEB_URL=http://localhost:3000
JWT_SECRET=change-me-to-a-long-random-string
# Emails that get access to the product owner console
PLATFORM_ADMIN_EMAILS=owner@vellaire.app

# --- Email (optional). Without a key, emails are printed in the API console ---
RESEND_API_KEY=
MAIL_FROM=Vellaire <hello@vellaire.app>

# --- AI (optional): none | claude | openai ---
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=
# Optional: your AI price in USD per million tokens (input / output), for the console cost estimate
AI_COST_IN_PER_MTOK=
AI_COST_OUT_PER_MTOK=

# --- Sign in with Google / Microsoft (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
